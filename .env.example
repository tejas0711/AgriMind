# ==============================================================================
# AgriMind Root Environment Configuration Template (.env.example)
#
# Use this file when orchestrating the full stack via Docker Compose.
# Never commit real API keys or sensitive production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Build-Time Settings (Public in browser bundle)
# ------------------------------------------------------------------------------
# In Docker Compose, the browser accesses the backend via http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend Runtime Settings (Server-side only)
# ------------------------------------------------------------------------------
POSTGRES_USER=agrimind
POSTGRES_PASSWORD=agrimind_dev_pass
POSTGRES_DB=agrimind_db

# Secret key for signing JWT tokens (generate via: openssl rand -hex 32)
JWT_SECRET_KEY=agrimind_dev_jwt_secret_key_change_in_production_32char

# Allowed CORS origins
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Optional LLM API Keys (Server-side only - leave blank for deterministic fallback)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

LLM_BASE_URL=
