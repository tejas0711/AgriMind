# ==============================================================================
# AgriMind Frontend Environment Configuration (.env.example)
#
# IMPORTANT: In Vite applications, all VITE_* variables are embedded directly
# into the compiled client-side JavaScript bundle at build time (npm run build).
# NEVER put private API keys, database credentials, or secret tokens here!
# ==============================================================================

# Backend API Base URL
# For local development: http://localhost:8000
# For production (Vercel/Render): https://your-backend-domain.onrender.com
VITE_API_BASE_URL=http://localhost:8000
