# ==============================================================================
# AgriMind Backend Configuration (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# This file defines RUNTIME SERVER-SIDE variables.
# Keep these values secure and NEVER expose them in public repositories or to client browsers.
# Copy this template to '.env' before starting the backend server.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME=AgriMind API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# ------------------------------------------------------------------------------
# CORS & Network Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can make cross-origin requests.
# In production, set this to your deployed frontend domain (e.g., https://agrimind.vercel.app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Persistent Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production or local Docker:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://agrimind:agrimind_dev_pass@localhost:5432/agrimind_db
# For lightweight local development without Docker, use SQLite:
# DATABASE_URL=sqlite:///./agrimind.db

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Keys (STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random string with: openssl rand -hex 32
JWT_SECRET_KEY=agrimind-dev-jwt-secret-key-replace-in-production-09a8b7c6d5e4f3a2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Storage & Vector Database Paths
# ------------------------------------------------------------------------------
# Directory where ChromaDB stores vector embeddings.
# On ephemeral platforms (Render free tier), vector index self-heals at boot time.
CHROMA_PERSIST_DIR=./vector_db
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# External Weather Service (Open-Meteo)
# ------------------------------------------------------------------------------
# Free public weather API - no authentication key required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# LLM Providers for Grounded Explanations (OPTIONAL)
# If no keys are provided, AgriMind automatically uses the deterministic fallback explainer.
# ------------------------------------------------------------------------------
# Primary Provider: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secondary Provider: Google Gemini (automatic fallback if OpenAI fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tertiary Provider: OpenRouter (automatic fallback if OpenAI and Gemini fail)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Local LLM (Ollama / vLLM / LM Studio / LocalAI)
# Example: http://localhost:11434/v1
LLM_BASE_URL=
